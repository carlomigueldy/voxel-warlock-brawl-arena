{
  "name": "voxel-warlock-brawl-arena",
  "version": "1.0.0",
  "description": "A 3D low-poly voxel Warlock Brawl clone (Three.js + WebGL) with P2P multiplayer (invite link, room code, QR code).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "parity": "node scripts/parity.mjs"
  },
  "keywords": [
    "threejs",
    "webgl",
    "voxel",
    "p2p",
    "peerjs",
    "game",
    "warlock"
  ],
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@supabase/supabase-js": "^2.109.0",
    "peerjs": "1.5.2",
    "qrcode": "1.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.160.0",
    "three-stdlib": "2.36.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/test-renderer": "9.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
