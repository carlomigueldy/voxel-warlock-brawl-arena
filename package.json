{
  "name": "voxel-warlock-brawl-arena",
  "version": "1.0.0",
  "description": "A 3D low-poly voxel Warlock Brawl clone (Three.js + WebGL) with P2P multiplayer (invite link, room code, QR code).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run"
  },
  "keywords": [
    "threejs",
    "webgl",
    "voxel",
    "p2p",
    "peerjs",
    "game",
    "warlock"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "peerjs": "1.5.2",
    "qrcode": "1.5.3",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
